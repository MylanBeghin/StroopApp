<UserControl x:Class="StroopApp.Views.Configuration.Profile.ProfileEditorCalculationModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StroopApp.Views.Configuration.Profile"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:StroopApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
    <UserControl.Resources>
        <converters:CalculationModeToBooleanConverter x:Key="CalculationModeToBooleanConverter" />
        <converters:MillisecondsToHoursConverter x:Key="MillisecondsToHoursConverter" />
        <converters:MillisecondsToMinutesConverter x:Key="MillisecondsToMinutesConverter" />
        <converters:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter" />
        <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <ui:SimpleStackPanel Spacing="16">
        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Label_CalculationMode]}"
       Style="{StaticResource SubtitleTextBlockStyle}" />
        <ui:SimpleStackPanel Orientation="Horizontal"
                 Spacing="12">
            <RadioButton Content="{Binding Source={StaticResource Loc}, Path=[Radio_TaskDuration]}"
             GroupName="CalculationModeGroup"
             IsChecked="{Binding CalculationMode,
                 Converter={StaticResource CalculationModeToBooleanConverter},
                 ConverterParameter=TaskDuration}" />
            <RadioButton Content="{Binding Source={StaticResource Loc}, Path=[Radio_WordCount]}"
             GroupName="CalculationModeGroup"
             IsChecked="{Binding CalculationMode,
                 Converter={StaticResource CalculationModeToBooleanConverter},
                 ConverterParameter=WordCount}" />
        </ui:SimpleStackPanel>
        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
    CornerRadius="8"
    Padding="16"
    BorderThickness="0.5"
    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CalculationMode}"
                         Value="TaskDuration">
                            <Setter Property="Visibility"
                        Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ui:SimpleStackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:NumberBox Header="{Binding Source={StaticResource Loc}, Path=[Header_Hours]}"
                      Value="{Binding Hours, Mode=TwoWay}"
                      Minimum="0"
                      SpinButtonPlacementMode="Inline"
                      Grid.Column="0" />
                    <ui:NumberBox Header="{Binding Source={StaticResource Loc}, Path=[Header_Minutes]}"
                      Value="{Binding Minutes, Mode=TwoWay}"
                      Minimum="0"
                      Maximum="59"
                      SpinButtonPlacementMode="Inline"
                      Grid.Column="2" />
                    <ui:NumberBox Header="{Binding Source={StaticResource Loc}, Path=[Header_Seconds]}"
                      Value="{Binding Seconds, Mode=TwoWay}"
                      Minimum="0"
                      Maximum="59"
                      SpinButtonPlacementMode="Inline"
                      Grid.Column="4" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:NumberBox Value="{Binding GroupSize, Mode=TwoWay}"
                      Minimum="1"
                      Grid.Column="0"
                      SpinButtonPlacementMode="Inline">
                        <ui:ControlHelper.Header>
                            <ui:SimpleStackPanel Orientation="Horizontal"
                                     VerticalAlignment="Center"
                                     Spacing="4"
                                     ToolTip="{Binding Source={StaticResource Loc}, Path=[Tooltip_AveragingInterval]}"
                                     ToolTipService.Placement="Top"
                                     ToolTipService.InitialShowDelay="100">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_GroupSize]}" />
                                <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Margin="0,4,0,0" />
                            </ui:SimpleStackPanel>
                        </ui:ControlHelper.Header>
                    </ui:NumberBox>
                </Grid>
                <ui:SimpleStackPanel Spacing="6">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Field_WordCount]}" />
                    <ui:NumberBox Text="{Binding StimulusCount, Mode=TwoWay}"
                      Style="{StaticResource ModernReadOnlyNumberBoxStyle}" />
                </ui:SimpleStackPanel>
            </ui:SimpleStackPanel>
        </Border>
        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
    CornerRadius="8"
    Padding="16"
    BorderThickness="0.5"
    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CalculationMode}"
                         Value="WordCount">
                            <Setter Property="Visibility"
                        Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ui:SimpleStackPanel Spacing="12">
                <ui:NumberBox Header="{Binding Source={StaticResource Loc}, Path=[Field_WordCount]}"
                  Value="{Binding StimulusCount, Mode=TwoWay}"
                  Minimum="1"
                  SpinButtonPlacementMode="Inline" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:NumberBox Value="{Binding GroupSize, Mode=TwoWay}"
                      Minimum="1"
                      Grid.Column="0"
                      SpinButtonPlacementMode="Inline">
                        <ui:ControlHelper.Header>
                            <ui:SimpleStackPanel Orientation="Horizontal"
                                     VerticalAlignment="Center"
                                     Spacing="4"
                                     ToolTip="{Binding Source={StaticResource Loc}, Path=[Tooltip_AveragingInterval]}"
                                     ToolTipService.Placement="Top"
                                     ToolTipService.InitialShowDelay="100">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_GroupSize]}" />
                                <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Margin="0,4,0,0" />
                            </ui:SimpleStackPanel>
                        </ui:ControlHelper.Header>
                    </ui:NumberBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SimpleStackPanel Spacing="6">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_Hours]}" />
                        <ui:NumberBox Text="{Binding TaskDuration, Converter={StaticResource MillisecondsToHoursConverter}}"
                          Style="{StaticResource ModernReadOnlyNumberBoxStyle}" />
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Spacing="6"
                             Grid.Column="2">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_Minutes]}" />
                        <ui:NumberBox Text="{Binding TaskDuration, Converter={StaticResource MillisecondsToMinutesConverter}}"
                          Style="{StaticResource ModernReadOnlyNumberBoxStyle}" />
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel Spacing="6"
                             Grid.Column="4">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_Seconds]}" />
                        <ui:NumberBox Text="{Binding TaskDuration, Converter={StaticResource MillisecondsToSecondsConverter}}"
                          Style="{StaticResource ModernReadOnlyNumberBoxStyle}" />
                    </ui:SimpleStackPanel>
                </Grid>
            </ui:SimpleStackPanel>
        </Border>
    </ui:SimpleStackPanel>
</UserControl>

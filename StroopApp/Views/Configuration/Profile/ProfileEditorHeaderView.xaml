<UserControl x:Class="StroopApp.Views.Configuration.Profile.ProfileEditorHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:StroopApp.Views.Configuration.Profile"
             xmlns:converters="clr-namespace:StroopApp.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="800"
             d:Background="White"
             >
    <ui:SimpleStackPanel Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.3*" />
            </Grid.ColumnDefinitions>
            <TextBox ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Field_ProfileName]}"
                     Text="{Binding ProfileName, Mode=TwoWay}" />
            <ComboBox ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Field_TaskLanguage]}"
                      ItemsSource ="{Binding Languages}"
                      SelectedItem="{Binding SelectedTaskLanguage, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.3*" />
            </Grid.ColumnDefinitions>
            <ui:SimpleStackPanel Orientation="Vertical" Grid.Row="1">
                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="4"
                                     VerticalAlignment="Center"
                                     ToolTip="{Binding Source={StaticResource Loc}, Path=[Tooltip_Congruence]}"
                                     ToolTipService.Placement="Top"
                                     ToolTipService.InitialShowDelay="100">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_Congruence_Percent]}" FontSize="14"/>
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Margin="0,4,0,0" />
                </ui:SimpleStackPanel>
                <Slider
                    Minimum="0"
                    Maximum="100"
                    LargeChange="5"
                    SmallChange="1"
                    Value="{Binding CongruencePercent, Mode=TwoWay}"
                    Grid.Column="0"/>
            </ui:SimpleStackPanel>
            <ui:NumberBox  Header=" "
                  Value="{Binding CongruencePercent, Mode=TwoWay}"
                  Minimum="0"
                  Maximum="100"
                  SpinButtonPlacementMode="Inline"
                  Grid.Column="2" />
        </Grid>
    </ui:SimpleStackPanel>
</UserControl>

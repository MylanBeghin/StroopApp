<Window x:Class="StroopApp.Views.Configuration.Profile.SimonProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroopApp.Views.Configuration.Profile"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="SimonProfileEditorWindow" Height="700" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="OpaqueDefaultButtonBackground"
                 Color="#c4c4c4"
                 Opacity="1" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <ui:SimpleStackPanel Margin="16,16,16,64" Spacing="16">
                <local:ProfileEditorHeaderView/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.25*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_TrialDuration]}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_FixationDuration]}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_MaxResponseTime]}" />
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="0"
                                  Text="{Binding StimulusDuration}"
                                  Style="{StaticResource ModernReadOnlyNumberBoxStyle}"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Text=" = "
                               HorizontalAlignment="Center"
                               FontSize="20" />
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="2"
                                  Value="{Binding FixationDuration, Mode=TwoWay}"
                                  Minimum="1"
                  SpinButtonPlacementMode="Inline" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               Text=" + "
                               HorizontalAlignment="Center"
                               FontSize="20"/>
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="4"
                                  Value="{Binding MaxReactionTime, Mode=TwoWay}"
                                  Minimum="1"
                                  SpinButtonPlacementMode="Inline" />
                </Grid>
                <local:ProfileEditorCalculationModeView/>
            </ui:SimpleStackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,16">
            <ui:SimpleStackPanel Orientation="Horizontal"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Spacing="16">
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Cancel]}"
                        Style="{StaticResource OpaqueButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Save]}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" />
            </ui:SimpleStackPanel>
        </DockPanel>
    </Grid>
</Window>

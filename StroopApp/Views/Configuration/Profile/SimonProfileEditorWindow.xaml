<Window x:Class="StroopApp.Views.Configuration.Profile.SimonProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroopApp.Views.Configuration.Profile"
        xmlns:ui="http://schemas.modernwpf.com/2019" 
        xmlns:profile="clr-namespace:StroopApp.ViewModels.Configuration.Profile" 
        xmlns:converters="clr-namespace:StroopApp.Converters" d:DataContext="{d:DesignInstance Type=profile:SimonProfileEditorViewModel}"
        mc:Ignorable="d"
        Title="SimonProfileEditorWindow" Height="700" Width="900" d:Height="1000">
    <Window.Resources>
        <SolidColorBrush x:Key="OpaqueDefaultButtonBackground"
                 Color="#c4c4c4"
                 Opacity="1" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <ui:SimpleStackPanel Margin="16,16,16,64" Spacing="16" >
                <local:ProfileEditorHeaderView />

                <local:ProfileSettingRow
                        Header="{Binding Source={StaticResource Loc}, Path=[Header_SimonAnswerMode]}"
                        Description="{Binding Source={StaticResource Loc}, Path=[Description_SimonAnswerMode]}">
                    <ComboBox Width="180" ItemsSource="{Binding AnswerModes}"
                              SelectedItem="{Binding SelectedAnswerMode, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>
                </local:ProfileSettingRow>

                <local:ProfileSettingRow
                        Header="{Binding Source={StaticResource Loc}, Path=[Header_SimonStimulusPositionMode]}"
                        Description="{Binding Source={StaticResource Loc}, Path=[Description_SimonStimulusPositionMode]}">
                    <ComboBox Width="180" ItemsSource="{Binding StimulusPositionModes}"
                              SelectedItem="{Binding SelectedStimulusPositionMode, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>
                </local:ProfileSettingRow>

                <local:ProfileSettingRow
                              Header="{Binding Source={StaticResource Loc}, Path=[Header_SimonStimulusMode]}"
                              Description="{Binding Source={StaticResource Loc}, Path=[Description_SimonStimulusMode]}">
                    <ComboBox Width="180" ItemsSource="{Binding StimulusModes}"
                              SelectedItem="{Binding SelectedStimulusMode}" DisplayMemberPath="DisplayName"/>
                    <local:ProfileSettingRow.DetailContent>
                        <ui:SimpleStackPanel Spacing="16" Margin="0 0 0 16">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                Visibility="{Binding IsStimulusModeShape, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonLeftShape]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="120"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusShapes}"
                                          SelectedItem="{Binding SelectedLeftShape, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonRightShape]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="120"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusShapes}"
                                          SelectedItem="{Binding SelectedRightShape, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                Visibility="{Binding IsStimulusModeColor, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonLeftColor]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="120"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusColors}"
                                          SelectedItem="{Binding SelectedLeftColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonRightColor]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="120"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusColors}"
                                          SelectedItem="{Binding SelectedRightColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                                 Visibility="{Binding IsStimulusModeShapeOrArrow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_BaseColor]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusColors}"
                                          SelectedItem="{Binding SelectedBaseColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding IsBaseColorUsed}"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Description_DisabledBaseColor]}" VerticalAlignment="Center" 
                                           
           Visibility="{Binding IsReversalCuePresentationIntegrated, Converter={StaticResource BoolToVisibility}}"/>
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                                 Visibility="{Binding IsStimulusModeColor, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_BaseShape]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusShapes}"
                                          SelectedItem="{Binding SelectedBaseShape, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding IsBaseShapeUsed}"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Description_DisabledBaseShape]}" VerticalAlignment="Center" 
                                           Visibility="{Binding IsReversalCuePresentationIntegrated, Converter={StaticResource BoolToVisibility}}"/>
                            </ui:SimpleStackPanel>
                        </ui:SimpleStackPanel>
                    </local:ProfileSettingRow.DetailContent>
                </local:ProfileSettingRow>

                <local:ProfileSettingRow
                              Header="{Binding Source={StaticResource Loc}, Path=[Header_SimonReversedMapping]}"
                              Description="{Binding Source={StaticResource Loc}, Path=[Description_SimonReversedMapping]}" >
                    <ComboBox Width="180" ItemsSource="{Binding ReversalCuePresentations}"
                              SelectedItem="{Binding SelectedReversalCuePresentation}" DisplayMemberPath="DisplayName"/>
                    <local:ProfileSettingRow.DetailContent>
                        <ui:SimpleStackPanel Spacing="16" Margin="0 0 0 16"
                                             Visibility="{Binding ShowReversalSettings, Converter={StaticResource BoolToVisibility}}">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                Visibility="{Binding IsReversalCueModalityShape, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonStandardShape]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding CueShapes}"
                                          SelectedItem="{Binding SelectedStandardShape, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonReversedShape]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding CueShapes}"
                                          SelectedItem="{Binding SelectedReversedShape, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16"
                                Visibility="{Binding IsReversalCueModalityColor, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonStandardColor]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusColors}"
                                          SelectedItem="{Binding SelectedStandardColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_SimonReversedColor]}" FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox VerticalAlignment="Center" Width="100"
                                          Grid.Column="3" Grid.Row="0"
                                          ItemsSource ="{Binding StimulusColors}"
                                          SelectedItem="{Binding SelectedReversedColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"/>
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Margin="0 0 0 8" Spacing="16" >
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Header_ReversedMappingPercent]}" FontSize="16" VerticalAlignment="Center"/>
                                <Slider Width="400" Minimum="0" Maximum="100" LargeChange="5" SmallChange="1"
                                        Value="{Binding ReversedMappingPercent, Mode=TwoWay}"/>
                                <ui:NumberBox Value="{Binding ReversedMappingPercent, Mode=TwoWay}"
                                              Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline"/>
                            </ui:SimpleStackPanel>
                        </ui:SimpleStackPanel>
                    </local:ProfileSettingRow.DetailContent>
                </local:ProfileSettingRow>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.25*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_TrialDuration]}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_FixationDuration]}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_VisualCueDuration]}"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="6"
                               Text="{Binding Source={StaticResource Loc}, Path=[Header_MaxResponseTime]}" />
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="0"
                                  Text="{Binding StimulusDuration}"
                                  Style="{StaticResource ModernReadOnlyNumberBoxStyle}"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Text=" = "
                               HorizontalAlignment="Center"
                               FontSize="20" />
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="2"
                                  Value="{Binding FixationDuration, Mode=TwoWay}"
                                  Minimum="1"
                  SpinButtonPlacementMode="Inline" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               Text=" + "
                               HorizontalAlignment="Center"
                               FontSize="20"/>
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="4"
                                  Value="{Binding VisualCueDuration, Mode=TwoWay}"
                                  Minimum="0"
                                  IsEnabled="{Binding IsReversalCuePresentationBefore}"
                                  SpinButtonPlacementMode="Inline"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="5"
                               VerticalAlignment="Center"
                               Text=" + "
                               HorizontalAlignment="Center"
                               FontSize="20"
                               />
                    <ui:NumberBox Grid.Row="2"
                                  Grid.Column="6"
                                  Value="{Binding MaxReactionTime, Mode=TwoWay}"
                                  Minimum="1"
                                  SpinButtonPlacementMode="Inline" />
                </Grid>
                <local:ProfileEditorCalculationModeView/>
            </ui:SimpleStackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,16">
            <ui:SimpleStackPanel Orientation="Horizontal"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Spacing="16">
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Cancel]}"
                        Style="{StaticResource OpaqueButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Save]}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" />
            </ui:SimpleStackPanel>
        </DockPanel>
    </Grid>
</Window>

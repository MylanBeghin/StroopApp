<Window x:Class="StroopApp.Views.Configuration.Profile.StroopProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:viewsProfile="clr-namespace:StroopApp.Views.Configuration.Profile"
        xmlns:converters="clr-namespace:StroopApp.Converters"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Title="{Binding Source={StaticResource Loc}, Path=[Title_ProfileEditorWindow]}"
        MinWidth="930"
        Width="685"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Window.Resources>
        <converters:CalculationModeToBooleanConverter x:Key="CalculationModeToBooleanConverter" />
        <converters:MillisecondsToHoursConverter x:Key="MillisecondsToHoursConverter" />
        <converters:MillisecondsToMinutesConverter x:Key="MillisecondsToMinutesConverter" />
        <converters:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter" />
        <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="OpaqueDefaultButtonBackground"
                         Color="#c4c4c4"
                         Opacity="1" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      x:Name="RootPanel"
                      Grid.Row="0"
                      Grid.RowSpan="2">
            <ui:SimpleStackPanel Margin="16,16,16,64"
                                 Spacing="16">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Title_ProfileEditorWindow]}"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderThickness="0.5"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <ui:SimpleStackPanel Spacing="12">
                        <viewsProfile:ProfileEditorHeaderView/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.25*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Source={StaticResource Loc}, Path=[Header_TrialDuration]}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="{Binding Source={StaticResource Loc}, Path=[Header_FixationDuration]}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="4"
                                       Text="{Binding Source={StaticResource Loc}, Path=[Header_VisualCueDuration]}" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="6"
                                       Text="{Binding Source={StaticResource Loc}, Path=[Header_MaxResponseTime]}" />
                            <ui:NumberBox Grid.Row="2"
                                     Grid.Column="0"
                                     Text="{Binding StimulusDuration}"
                                          Style="{StaticResource ModernReadOnlyNumberBoxStyle}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text=" = "
                                       HorizontalAlignment="Center"
                                       FontSize="20" />
                            <ui:NumberBox Grid.Row="2"
                                          Grid.Column="2"
                                          Value="{Binding FixationDuration, Mode=TwoWay}"
                                          Minimum="1"
                                          SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text=" + "
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       />
                            <ui:NumberBox Grid.Row="2"
                                          Grid.Column="4"
                                          Value="{Binding VisualCueDuration, Mode=TwoWay}"
                                          Minimum="0"
                                          IsEnabled="{Binding HasVisualCue}"
                                          SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="5"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Text=" + " />
                            <ui:NumberBox Grid.Row="2"
                                          Grid.Column="6"
                                          Value="{Binding MaxReactionTime, Mode=TwoWay}"
                                          Minimum="1"
                                          SpinButtonPlacementMode="Inline" />
                        </Grid>
                    </ui:SimpleStackPanel>
                </Border>
                <ui:SimpleStackPanel Spacing="0">
                    <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                            Padding="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisualCue}"
                                                 Value="True">
                                        <Setter Property="CornerRadius"
                                                Value="8,8,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Label_AddPrime] }"
                                       VerticalAlignment="Center" />
                            <ui:ToggleSwitch IsOn="{Binding HasVisualCue, Mode=TwoWay}"
                                             OnContent="{Binding Source={StaticResource Loc}, Path=[Toggle_On]}"
                                             OffContent="{Binding Source={StaticResource Loc}, Path=[Toggle_Off]}"
                                             VerticalAlignment="Center"
                                             Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             Margin="0,0,-30,0" />
                        </Grid>
                    </Border>
                    <viewsProfile:SwitchSettingsView DataContext="{Binding SwitchSettingsViewModel}"
                                                     Visibility="{Binding DataContext.HasVisualCue, ElementName=RootPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                </ui:SimpleStackPanel>
                <viewsProfile:ProfileEditorCalculationModeView/>
            </ui:SimpleStackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,16">
            <ui:SimpleStackPanel Orientation="Horizontal"
                                 Spacing="16"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Cancel]}"
                        Style="{StaticResource OpaqueButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Content="{Binding Source={StaticResource Loc}, Path=[Button_Save]}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" />
            </ui:SimpleStackPanel>
        </DockPanel>
    </Grid>
</Window>

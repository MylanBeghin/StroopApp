<UserControl x:Class="StroopApp.Views.Configuration.TaskSelection.TaskSelectionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StroopApp.Views.Configuration.TaskSelection" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="250"
             Background="White"
             x:Name="Root">
    <Grid>
        <Button Margin="5" MinWidth="200">
            <ui:SimpleStackPanel VerticalAlignment="Center">

                <TextBlock Text="{Binding TextTitle, ElementName=Root}"
                           TextAlignment="Left" 
                           FontSize="16" FontWeight="DemiBold"  Background="Transparent"
                           />

                <TextBlock Text="{Binding TextDescription, ElementName=Root}"
                           TextAlignment="Left" TextWrapping="Wrap" FontSize="12" Width="200" Height="40"
                            />
            </ui:SimpleStackPanel>
        </Button>
    </Grid>
</UserControl>

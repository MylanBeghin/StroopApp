<Window x:Class="StroopApp.Views.Configuration.TaskSelection.TaskSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroopApp.Views.Configuration.TaskSelection" 
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:profile="clr-namespace:StroopApp.Views.Configuration.TaskSelection"
        mc:Ignorable="d"
        Title="Choix de la tâche expérimentale" Height="500" Width="800"
        ui:WindowHelper.UseModernWindowStyle="True"
        WindowStartupLocation="CenterOwner"
        >
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              x:Name="RootPanel">

            <ui:SimpleStackPanel HorizontalAlignment="Left" >

                <TextBlock Text="Choix de la tâche expérimentale"
               Style="{StaticResource TitleTextBlockStyle}" Margin="5" />
                <TextBlock Text="Tâche de Stroop" FontSize="20" Margin="10"/>
                <ui:SimpleStackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                    <profile:TaskSelectionButton TextTitle="Observation" TextDescription="Nommer la couleur de l'encre"/>
                    <profile:TaskSelectionButton TextTitle="Lecture" TextDescription="Lire le mot affiché"/>
                    <profile:TaskSelectionButton TextTitle="Observation+Lecture" TextDescription="Alternance des deux consignes selon l'amorce"/>
                </ui:SimpleStackPanel>
                <TextBlock Text="Go/No-Go" FontSize="20" Margin="10"/>
                <ui:SimpleStackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <profile:TaskSelectionButton TextTitle="Go/No-Go" TextDescription="Répondre ou non selon la couleur du stimulus"/>
                </ui:SimpleStackPanel>
                <TextBlock Text="Simon" FontSize="20" Margin="10"/>
                <ui:SimpleStackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <profile:TaskSelectionButton TextTitle="Tâche spatiale" TextDescription="Répondre à droite ou gauche selon la position du stimulus"/>
                    <profile:TaskSelectionButton TextTitle="Tâche droite/gauche" TextDescription="Répondre à droite ou gauche selon la couleur du stimulus"/>
                    <profile:TaskSelectionButton TextTitle="Tâche de Simon" TextDescription="Répondre à droite ou gauche selon la couleur (positions variables)"/>
                </ui:SimpleStackPanel>
            </ui:SimpleStackPanel>
        </ScrollViewer>

    </Grid>
</Window>

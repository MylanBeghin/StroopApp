<UserControl x:Class="StroopApp.Views.Experiment.Participant.Simon.SimonStimulusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StroopApp.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StroopApp.Views.Experiment.Participant.Simon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:StimulusPositionToGridColumnConverter x:Key="PositionToGridColumnConverter" />
        <conv:StimulusPositionToGridColumnSpanConverter x:Key="PositionToGridColumnSpanConverter" />
    </UserControl.Resources>
    <Grid Background="Black" Width="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="100" Height="100"
                 Fill="{Binding ForegroundBrush}"
                 Grid.Column="{Binding Position, Converter={StaticResource PositionToGridColumnConverter}}"
                 Grid.ColumnSpan="{Binding Position, Converter={StaticResource PositionToGridColumnSpanConverter}}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>
</UserControl>

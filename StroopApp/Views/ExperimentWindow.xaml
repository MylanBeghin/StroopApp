<Window x:Class="StroopApp.Views.ExperimentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:converters="clr-namespace:StroopApp.Converters"
        Title=""
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        ui:WindowHelper.UseModernWindowStyle="True"
        >
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="HomePageMenuItem" Header="{Binding Source={StaticResource Loc}, Path=[Menu_Home]}" Visibility="{Binding IsNotOnHomePage, Converter={StaticResource BoolToVisibilityConverter}}"
                      Command="{Binding ReturnHomePageCommand}"/>
            <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[Menu_Display], FallbackValue=Display}">
                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=[Menu_Languages], FallbackValue=Languages}">
                    <MenuItem Header="English"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglishSelected, Mode=OneWay}"
                              Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="en" />
                    <MenuItem Header="Français"
                              IsCheckable="True"
                              IsChecked="{Binding IsFrenchSelected, Mode=OneWay}"
                              Command="{Binding ChangeLanguageCommand}"
                              CommandParameter="fr" />
                </MenuItem>
            </MenuItem>
        </Menu>
        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden" />
    </DockPanel>
</Window>
